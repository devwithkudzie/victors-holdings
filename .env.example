# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://victorsholdings.co.zw

# Victors WhatsApp number in international format, digits only (e.g. 263771234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=263782086781

# Optional tracking — leave blank to disable
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Design variations: a = Bold, b = App, c = Premium
# Default design shown to visitors (the client can switch while the picker is on)
NEXT_PUBLIC_DEFAULT_DESIGN=a
# Set to "off" once the client has chosen, to hide the "Choose design" switch
NEXT_PUBLIC_DESIGN_PICKER=on
