# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://victorsholdings.co.zw

# Victors WhatsApp number in international format, digits only (e.g. 263771234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=263782086781

# Tracking. GA4 is built in (G-T0TXMTQY28); set NEXT_PUBLIC_GA_ID only to override. Meta Pixel: leave blank to disable.
NEXT_PUBLIC_GA_ID=G-T0TXMTQY28
NEXT_PUBLIC_META_PIXEL_ID=


# ---------- Brick calculator ----------
# Plan reading AI — choose ONE provider and set its key (without any key, customers use "house size")
# anthropic | openai | gemini  (if blank, the first provider with a key is used)
PLAN_READER_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Use a PAID Gemini API project — on the free tier Google may use submitted content to improve its products
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
# Long random string used to sign estimates and quotation links (required in production)
QUOTE_SECRET=

# WhatsApp Business Platform (Cloud API) — switches on automatic WhatsApp messages
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
# Number that receives new-lead alerts (digits only) and the approved alert template
WHATSAPP_ALERT_TO=263782086781
WHATSAPP_LEAD_TEMPLATE=
# Approved template with a document header, for sending the quotation to the customer
WHATSAPP_QUOTE_TEMPLATE=

# Optional backup: every lead is POSTed here as JSON (e.g. a Google Apps Script that writes to a Sheet)
LEAD_WEBHOOK_URL=

# ---------- Abuse protection (brick calculator) ----------
# Cloudflare Turnstile bot check (free): dash.cloudflare.com → Turnstile → add site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Shared rate limits + re-upload cache (free Upstash Redis: upstash.com, or Vercel → Storage → Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Site-wide cap on AI plan reads per day (protects the AI bill)
PLAN_READS_PER_DAY=300

# ---------- Tora Mari (affiliates) ----------
# Neon Postgres — added automatically by Vercel → Storage → Neon. Then run: npm run db:migrate
DATABASE_URL=
# First admin login for /admin (used once, while no staff accounts exist)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Signs login sessions and quotation links (already used by the brick calculator)
# QUOTE_SECRET=
